# ==============================================================================
# Jersey Automate - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta / WhatsApp Cloud API Credentials
# ------------------------------------------------------------------------------
# Found at developers.facebook.com -> App Dashboard -> Settings -> Basic
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version (e.g., v21.0 or v22.0)
GRAPH_API_VERSION=v21.0

# Permanent System User Access Token (generated in Meta Business Settings)
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here

# Phone Number ID (Found at developers.facebook.com -> WhatsApp -> API Setup)
# NOTE: This is an ID number (e.g. 105938272910293), NOT your actual phone number.
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID (WABA ID) (Found on the same API Setup screen)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# Optional: Configuration ID for Embedded Signup Facebook Login button
META_CONFIG_ID=your_meta_config_id_here

# ------------------------------------------------------------------------------
# 2. Webhooks Configuration
# ------------------------------------------------------------------------------
# A custom secret string you choose; paste the same string into Meta Webhook Verify Token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=jersey_automate_webhook_secret_2026

# ------------------------------------------------------------------------------
# 3. Security & Token Encryption
# ------------------------------------------------------------------------------
# 32-byte (64 hex characters) AES-256-GCM encryption key for securely encrypting tokens in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 5. Database (Supabase) - Optional for initial WhatsApp standalone testing
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 6. Payment Gateway (Paystack) - Optional for initial WhatsApp testing
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# ------------------------------------------------------------------------------
# 7. AI Engine (OpenAI) - Optional for initial WhatsApp testing
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
