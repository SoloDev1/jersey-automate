{
  "name": "jersey-automate",
  "version": "1.0.0",
  "description": "Jersey E-Commerce Backend & WhatsApp Automation System",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "scrape": "node scraper/scripts/scrape.js",
    "sync:neon": "node scraper/scripts/sync-neon-storage.js",
    "test:whatsapp": "tsx scripts/test-whatsapp.ts",
    "test:verify": "tsx scripts/verify-session-and-freshness.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "whatsapp",
    "crm",
    "jersey",
    "paystack",
    "neon",
    "prisma"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@prisma/client": "^6.4.1",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "openai": "^4.85.4",
    "socket.io": "^4.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "prisma": "^6.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11"
  }
}
